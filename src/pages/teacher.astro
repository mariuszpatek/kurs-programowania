---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Panel nauczyciela" wide>
  <p class="eyebrow">Tylko dla nauczyciela</p>
  <h1>Panel</h1>
  <p class="lead" id="teacher-info">Ładuję…</p>

  <section class="card add" id="add-student" hidden>
    <p class="eyebrow">Dodaj ucznia</p>
    <form id="add-form">
      <div class="field grow">
        <label for="add-email">E-mail ucznia</label>
        <input id="add-email" type="email" required placeholder="uczen@email.pl" />
      </div>
      <div class="field">
        <label for="add-course">Kurs</label>
        <select id="add-course" required></select>
      </div>
      <div class="field narrow">
        <label for="add-unlocked">Do lekcji</label>
        <input id="add-unlocked" type="number" min="0" value="1" required />
      </div>
      <button class="primary" type="submit">Dodaj</button>
    </form>
    <p class="form-message" id="add-message" role="status"></p>
  </section>

  <nav class="panel-nav" id="panel-nav" hidden>
    <a href="#students">Uczniowie</a>
    <a href="#lesson-notes">Lekcje</a>
  </nav>

  <div id="students" class="students"></div>

  <section class="lesson-notes" id="lesson-notes" hidden>
    <h2>Lekcje</h2>
    <p class="muted">Publikacja lekcji i notatki dla nauczyciela (plan, przykłady, odpowiedzi). Szkic widzisz tylko Ty, a po publikacji widzą go uczniowie, którzy mają odblokowaną tę lekcję.</p>
    <div id="lesson-notes-list"></div>
  </section>
</Layout>

<script>
  import { requireAccess, setPreviewAsStudent, lessons, tasks, teacherNotes, setLessonPublished, lessonPath, type Course, type Enrollment, type Lesson, type Task } from '../lib/content';
  import { renderMarkdown, enhanceContent } from '../lib/markdown';
  import { splitTeacherNotes, notesAsMarkdown } from '../lib/teacher-notes';
  import { supabase } from '../lib/supabase';

  type TestResult = { name: string; ok: boolean };
  type PredictLine = { student: string | null; actual: string | null; ok: boolean };
  type Attempt = { email: string; task_id: string; code: string; passed: boolean; results: unknown; created_at: string };
  type CourseData = { course: Course; lessonCount: number; lessons: Lesson[]; tasks: Task[]; notes: Map<number, string> };

  const $ = (id: string) => document.getElementById(id)!;
  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, text = '', className = '') => {
    const e = document.createElement(tag);
    e.textContent = text;
    if (className) e.className = className;
    return e;
  };
  const plural = (n: number) => (n === 1 ? 'próba' : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? 'próby' : 'prób');
  const when = (s: string) => new Date(s).toLocaleString('pl-PL', { day: 'numeric', month: 'short', hour: '2-digit', minute: '2-digit' });

  let courseData = new Map<string, CourseData>();
  let attempts: Attempt[] = [];

  /** What went wrong in an attempt: names of failed tests, or mispredicted lines. */
  function failures(a: Attempt): string[] {
    if (!Array.isArray(a.results)) return [];
    return (a.results as (TestResult | PredictLine)[]).flatMap((r, i) => {
      if (r.ok) return [];
      if ('name' in r) return [r.name];
      return [`linijka ${i + 1}: „${r.student ?? ''}” zamiast „${r.actual ?? ''}”`];
    });
  }

  function history(list: Attempt[]) {
    const ol = el('ol', '', 'history');
    list.forEach((a, i) => {
      const li = el('li');
      const head = el('div', '', 'attempt-head');
      head.append(
        el('span', `#${list.length - i}`, 'row-number'),
        el('span', a.passed ? 'zaliczona' : 'nie przeszła', `status-dot ${a.passed ? 'done' : 'started'}`),
        el('span', when(a.created_at), 'when'),
      );
      li.append(head);
      const failed = failures(a);
      if (failed.length) li.append(el('p', `Nie przeszło: ${failed.join(' · ')}`, 'failed'));
      const code = el('details', '', 'attempt-code');
      code.append(el('summary', 'Kod'), el('pre', a.code));
      code.open = i === 0;
      li.append(code);
      ol.append(li);
    });
    return ol;
  }

  /** Two clicks instead of confirm(): the first arms the button, a second within 3 s runs the action. */
  function confirmButton(label: string, armedLabel: string, action: () => Promise<void>) {
    const button = el('button', label, 'ghost');
    let timer: number | undefined;
    button.addEventListener('click', async () => {
      if (!timer) {
        button.textContent = armedLabel;
        timer = window.setTimeout(() => ((timer = undefined), (button.textContent = label)), 3000);
        return;
      }
      clearTimeout(timer);
      button.disabled = true;
      await action();
    });
    return button;
  }

  async function setUnlocked(e: Enrollment, value: number) {
    const { error } = await supabase
      .from('lms_enrollments')
      .update({ unlocked_through: value })
      .eq('email', e.email)
      .eq('course_id', e.course_id);
    if (error) alertInline(`Nie udało się zmienić: ${error.message}`);
    else e.unlocked_through = value;
  }

  function alertInline(text: string) {
    $('teacher-info').textContent = text;
  }

  function enrollmentCard(e: Enrollment) {
    const data = courseData.get(e.course_id);
    const card = el('section', '', 'student card');
    if (!data) return card;
    const mine = attempts.filter((a) => a.email === e.email && data.tasks.some((t) => t.id === a.task_id));
    const done = data.tasks.filter((t) => mine.some((a) => a.task_id === t.id && a.passed)).length;
    const last = mine[0];

    const head = el('header');
    const who = el('div');
    who.append(
      el('h2', e.email),
      el('p', `${data.course.title} · ${last ? `ostatnio ${when(last.created_at)}` : 'jeszcze nic nie sprawdzał'}`, 'muted'),
    );

    const unlock = el('div', '', 'unlock');
    const value = el('strong', String(e.unlocked_through));
    const minus = el('button', '−');
    const plus = el('button', '+');
    minus.setAttribute('aria-label', 'Zablokuj ostatnią lekcję');
    plus.setAttribute('aria-label', 'Odblokuj kolejną lekcję');
    const refresh = () => {
      value.textContent = String(e.unlocked_through);
      minus.disabled = e.unlocked_through <= 0;
    };
    minus.addEventListener('click', async () => (await setUnlocked(e, e.unlocked_through - 1), refresh()));
    plus.addEventListener('click', async () => (await setUnlocked(e, e.unlocked_through + 1), refresh()));
    refresh();
    const unlockLabel = el('span', `odblokowane do lekcji (z ${data.lessonCount})`, 'muted');
    unlock.append(minus, value, plus, unlockLabel);

    const score = el('div', '', 'score');
    score.append(el('strong', `${done}/${data.tasks.filter((t) => t.lesson_number <= e.unlocked_through).length}`), el('span', 'zaliczonych', 'muted'));
    head.append(who, unlock, score);
    card.append(head);

    for (const t of data.tasks) {
      const list = mine.filter((a) => a.task_id === t.id);
      const passed = list.some((a) => a.passed);
      const locked = t.draft || t.lesson_number > e.unlocked_through;
      const row = el('details', '', `task-row ${locked ? 'locked' : ''}`);
      const summary = el('summary');
      summary.append(
        el('span', `${t.lesson_number}.${t.number}`, 'row-number'),
        el('span', t.title, 'row-title'),
        el(
          'span',
          t.draft ? 'szkic, uczeń nie widzi' : locked ? 'zablokowane' : list.length ? (passed ? 'zaliczone' : 'w trakcie') : 'nie zaczęte',
          `status-dot ${passed ? 'done' : list.length ? 'started' : ''}`,
        ),
        el('span', list.length ? `${list.length} ${plural(list.length)}` : '', 'count'),
      );
      row.append(summary, list.length ? history(list) : el('p', 'Brak prób.', 'muted empty'));
      card.append(row);
    }

    const footer = el('div', '', 'student-footer');
    footer.append(
      passwordForm(e.email),
      confirmButton('Usuń z kursu', 'Na pewno? Kliknij znowu', async () => {
        const { error } = await supabase.from('lms_enrollments').delete().eq('email', e.email).eq('course_id', e.course_id);
        if (error) alertInline(`Nie udało się usunąć: ${error.message}`);
        else card.remove();
      }),
    );
    card.append(footer);
    return card;
  }

  /** For when the login link does not reach the student: the teacher sets a password (lms-invite). */
  function passwordForm(email: string) {
    const form = el('form', '', 'set-password');
    const input = el('input');
    input.type = 'text';
    input.minLength = 8;
    input.required = true;
    input.placeholder = 'Nowe hasło ucznia';
    input.autocomplete = 'off';
    input.setAttribute('aria-label', `Nowe hasło dla ${email}`);
    const button = el('button', 'Ustaw hasło', 'ghost');
    const message = el('span', '', 'muted');
    form.append(input, button, message);
    form.addEventListener('submit', async (ev) => {
      ev.preventDefault();
      button.disabled = true;
      const { data, error } = await supabase.functions.invoke('lms-invite', { body: { email, password: input.value } });
      button.disabled = false;
      if (error || data?.error) {
        // a 4xx from the function arrives as an error whose response body has the reason
        const reason = data?.error ?? (await error?.context?.json?.().catch(() => null))?.error;
        message.textContent = reason ?? 'Nie udało się ustawić hasła.';
        return;
      }
      message.textContent = 'Ustawione. Przekaż hasło uczniowi.';
      input.value = '';
    });
    return form;
  }

  function lessonRow(course: Course, lesson: Lesson, notes: string | undefined) {
    const item = el('div', '', 'lesson-row');
    const head = el('div', '', 'lesson-row-head');
    const title = el('div');
    const link = el('a', lesson.title, 'note-title') as HTMLAnchorElement;
    link.href = lessonPath(course, lesson.number);
    title.append(el('span', `${course.title} · Lekcja ${lesson.number}`, 'eyebrow'), link);

    const state = el('div', '', 'lesson-state');
    const badge = el('span');
    const message = el('span', '', 'muted state-message');
    const render = () => {
      badge.className = lesson.draft ? 'draft-badge' : 'status-dot done';
      badge.textContent = lesson.draft ? 'szkic' : 'opublikowana';
      button.textContent = lesson.draft ? 'Opublikuj' : 'Cofnij do szkicu';
      button.className = lesson.draft ? 'primary' : 'ghost';
    };
    // publishing is one click; hiding a lesson from students again needs a second click to confirm
    let armed: number | undefined;
    const button = el('button');
    button.addEventListener('click', async () => {
      if (!lesson.draft && !armed) {
        button.textContent = 'Na pewno? Uczniowie przestaną ją widzieć';
        armed = window.setTimeout(() => ((armed = undefined), render()), 3000);
        return;
      }
      clearTimeout(armed);
      armed = undefined;
      button.disabled = true;
      const error = await setLessonPublished(course.id, lesson.number, lesson.draft);
      button.disabled = false;
      if (error) {
        message.textContent = `Nie udało się: ${error}`;
        return;
      }
      lesson.draft = !lesson.draft;
      message.textContent = lesson.draft ? 'Cofnięta do szkicu.' : 'Opublikowana. Pamiętaj, żeby odblokować ją uczniom (+ przy uczniu).';
      render();
    });
    render();
    state.append(badge, button);
    head.append(title, state);
    item.append(head, message);

    if (notes) {
      const details = el('details', '', 'note-item');
      const body = el('div', '', 'prose');
      const { general, inline } = splitTeacherNotes(notes);
      body.innerHTML = renderMarkdown(notesAsMarkdown(general, inline));
      enhanceContent(body);
      details.append(el('summary', 'Notatki dla nauczyciela'), body);
      item.append(details);
    }
    return item;
  }

  function showLessons() {
    const rows = [...courseData.values()].flatMap(({ course, lessons: ls, notes }) => ls.map((l) => lessonRow(course, l, notes.get(l.number))));
    if (!rows.length) return;
    $('lesson-notes-list').replaceChildren(...rows);
    $('lesson-notes').hidden = false;
    $('panel-nav').hidden = false;
  }

  async function load() {
    const [{ data: enrollments }, { data: rawAttempts, error }] = await Promise.all([
      supabase.from('lms_enrollments').select('email, course_id, unlocked_through').order('created_at'),
      supabase.rpc('lms_teacher_attempts'),
    ]);
    if (error) {
      alertInline(`Brak dostępu do panelu: ${error.message}`);
      return;
    }
    attempts = rawAttempts ?? [];
    const list = (enrollments ?? []) as Enrollment[];
    alertInline(
      list.length
        ? 'Uczniowie, ich kursy i postępy. Kliknij zadanie, żeby zobaczyć wszystkie próby i kod.'
        : 'Nie ma jeszcze uczniów. Dodaj pierwszego formularzem poniżej.',
    );
    $('students').replaceChildren(...list.map(enrollmentCard));
  }

  requireAccess().then(async (access) => {
    if (!access) return;
    if (access.previewing) {
      // the dashboard makes no sense as a student: leave the preview
      setPreviewAsStudent(false);
      location.reload();
      return;
    }
    if (!access.isTeacher) {
      alertInline('Ta strona jest tylko dla nauczyciela.');
      return;
    }
    const entries = await Promise.all(
      access.courses.map(async (course) => {
        const [ls, ts, notes] = await Promise.all([lessons(course.id), tasks(course.id), teacherNotes(course.id)]);
        return [course.id, { course, lessonCount: ls.length, lessons: ls, tasks: ts, notes }] as const;
      }),
    );
    courseData = new Map(entries);
    ($('add-course') as HTMLSelectElement).replaceChildren(
      ...access.courses.map((c) => {
        const o = el('option', [c.title, c.level].filter(Boolean).join(' · '));
        o.value = c.id;
        return o;
      }),
    );
    $('add-student').hidden = false;
    showLessons();
    await load();
  });

  $('add-form').addEventListener('submit', async (e) => {
    e.preventDefault();
    const email = ($('add-email') as HTMLInputElement).value.trim().toLowerCase();
    const courseId = ($('add-course') as HTMLSelectElement).value;
    const unlocked = Number(($('add-unlocked') as HTMLInputElement).value);
    const message = $('add-message');
    const button = (e.target as HTMLFormElement).querySelector('button')!;
    button.disabled = true;
    message.textContent = 'Dodaję…';

    const { error } = await supabase.from('lms_enrollments').insert({ email, course_id: courseId, unlocked_through: unlocked });
    if (error) {
      message.textContent = error.code === '23505' ? 'Ten uczeń jest już zapisany na ten kurs.' : `Nie udało się dodać: ${error.message}`;
      button.disabled = false;
      return;
    }
    const { error: inviteError } = await supabase.functions.invoke('lms-invite', { body: { email } });
    message.textContent = inviteError
      ? 'Zapisano na kurs, ale nie udało się założyć konta. Załóż je ręcznie w Supabase (Authentication → Add user).'
      : `Dodano ${email}. Uczeń loguje się na stronie swoim e-mailem, bez hasła.`;
    ($('add-email') as HTMLInputElement).value = '';
    button.disabled = false;
    await load();
  });
</script>

<style>
  .panel-nav {
    display: flex;
    gap: 8px;
    margin-top: 8px;
  }
  .panel-nav a {
    font-size: 14px;
    padding: 6px 12px;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--text-2);
    background: var(--surface);
  }
  .panel-nav a:hover {
    color: var(--text);
    text-decoration: none;
  }
  .students,
  .lesson-notes {
    scroll-margin-top: 80px;
  }
  .lesson-notes {
    margin-top: 56px;
  }
  .lesson-notes h2 {
    margin-bottom: 4px;
  }
  #lesson-notes-list {
    display: grid;
    gap: 12px;
    margin-top: 20px;
  }
  #lesson-notes-list :global(.lesson-row) {
    padding: 18px 22px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }
  #lesson-notes-list :global(.lesson-row-head) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px 24px;
    flex-wrap: wrap;
  }
  #lesson-notes-list :global(.lesson-row-head > div:first-child) {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }
  #lesson-notes-list :global(.note-title) {
    font-weight: 600;
    font-size: 1.05rem;
    color: var(--text);
  }
  #lesson-notes-list :global(.lesson-state) {
    display: flex;
    align-items: center;
    gap: 12px;
  }
  #lesson-notes-list :global(.lesson-state .draft-badge) {
    margin-left: 0;
  }
  #lesson-notes-list :global(.state-message) {
    display: block;
    font-size: 13.5px;
    margin-top: 6px;
  }
  #lesson-notes-list :global(.state-message:empty) {
    display: none;
  }
  #lesson-notes-list :global(.note-item) {
    margin-top: 14px;
    padding: 0 16px;
    border: 1px dashed color-mix(in srgb, #c27a12 55%, transparent);
    border-radius: 10px;
    background: color-mix(in srgb, #c27a12 5%, var(--surface));
  }
  #lesson-notes-list :global(.note-item > summary) {
    padding: 10px 0;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
  }
  .add {
    margin-top: 32px;
    padding: 20px 24px;
  }
  #add-form {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    align-items: flex-end;
    margin-top: 12px;
  }
  .field {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 180px;
  }
  .field.grow {
    flex: 1;
    min-width: 220px;
  }
  .field.narrow {
    min-width: 0;
    width: 100px;
  }
  .field label {
    font-size: 13px;
    color: var(--text-2);
  }
  #add-form button {
    height: 40px;
  }
  .form-message {
    margin: 10px 0 0;
    font-size: 14px;
    color: var(--text-2);
  }
  .form-message:empty {
    display: none;
  }
  .students {
    display: grid;
    gap: 24px;
    margin-top: 32px;
  }
  .students :global(.student) {
    padding: 24px 24px 12px;
  }
  .students :global(header) {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 32px;
    flex-wrap: wrap;
    margin-bottom: 16px;
  }
  .students :global(h2) {
    margin: 0;
    font-size: 1.2rem;
    word-break: break-all;
  }
  .students :global(header p) {
    margin: 2px 0 0;
    font-size: 14px;
  }
  .students :global(.unlock) {
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .students :global(.unlock button) {
    width: 32px;
    padding: 0;
    font-size: 16px;
  }
  .students :global(.unlock strong) {
    min-width: 24px;
    text-align: center;
    font-size: 1.2rem;
    font-variant-numeric: tabular-nums;
  }
  .students :global(.unlock .muted) {
    font-size: 13.5px;
  }
  .students :global(.score) {
    display: flex;
    align-items: baseline;
    gap: 6px;
  }
  .students :global(.score strong) {
    font-size: 1.8rem;
    letter-spacing: -0.03em;
    font-variant-numeric: tabular-nums;
  }
  .students :global(.task-row) {
    border-top: 1px solid var(--line);
  }
  .students :global(.task-row.locked) {
    opacity: 0.5;
  }
  .students :global(.task-row > summary) {
    display: grid;
    grid-template-columns: 40px 1fr auto 72px;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    cursor: pointer;
    list-style: none;
  }
  .students :global(.task-row > summary::-webkit-details-marker) {
    display: none;
  }
  .students :global(.task-row > summary:hover .row-title) {
    color: var(--accent);
  }
  .students :global(.count) {
    font-size: 13px;
    color: var(--text-3);
    text-align: right;
    font-variant-numeric: tabular-nums;
  }
  .students :global(.empty) {
    margin: 0 0 14px 52px;
    font-size: 14px;
  }
  .students :global(.history) {
    list-style: none;
    margin: 0 0 16px 52px;
    padding: 0 0 0 16px;
    border-left: 1px solid var(--line);
  }
  .students :global(.history li) {
    margin: 0 0 14px;
  }
  .students :global(.attempt-head) {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 13.5px;
  }
  .students :global(.when) {
    color: var(--text-3);
  }
  .students :global(.failed) {
    margin: 4px 0 0;
    font-size: 13.5px;
    color: var(--bad);
  }
  .students :global(.attempt-code summary) {
    font-size: 13px;
    color: var(--text-2);
    cursor: pointer;
    margin-top: 4px;
  }
  .students :global(.attempt-code pre) {
    margin: 8px 0 0;
    font-size: 13px;
  }
  .students :global(.set-password) {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    margin-right: auto;
  }
  .students :global(.set-password input) {
    width: 180px;
  }
  .students :global(.set-password .muted) {
    font-size: 13px;
  }
  .students :global(.student-footer) {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: flex-end;
    padding-top: 12px;
    border-top: 1px solid var(--line);
  }
  @media (max-width: 640px) {
    .students :global(.student) {
      padding: 20px 16px 8px;
    }
    .students :global(.task-row > summary) {
      grid-template-columns: 32px 1fr auto;
    }
    .students :global(.count) {
      display: none;
    }
    .students :global(.history),
    .students :global(.empty) {
      margin-left: 8px;
    }
  }
</style>
