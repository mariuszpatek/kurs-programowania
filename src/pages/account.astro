---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Konto">
  <p class="eyebrow">Konto</p>
  <h1 id="account-email"></h1>
  <p class="muted" id="account-role"></p>
  <button id="logout">Wyloguj</button>

  <section class="card limits">
    <h2>Limity AI</h2>
    <div id="ai-limits"><p class="muted">sprawdzam…</p></div>
    <p class="muted">Wiadomości do Robcia i pytania do asystenta liczą się od północy. Wydatki na model w zadaniach z <code>ask()</code> liczą się od początku miesiąca.</p>
  </section>

  <form id="password-form" class="card password">
    <h2>Hasło</h2>
    <p class="muted">Z hasłem zalogujesz się także wtedy, gdy link z maila nie dojdzie. Co najmniej 8 znaków.</p>
    <label class="eyebrow" for="new-password">Nowe hasło</label>
    <input id="new-password" name="password" type="password" minlength="8" required autocomplete="new-password" />
    <label class="eyebrow" for="repeat-password">Powtórz hasło</label>
    <input id="repeat-password" name="repeat" type="password" minlength="8" required autocomplete="new-password" />
    <button class="primary" type="submit">Ustaw hasło</button>
    <p id="password-message" class="muted" role="status" hidden></p>
  </form>
</Layout>

<script>
  import { requireAccess } from '../lib/content';
  import { supabase } from '../lib/supabase';
  import { url } from '../lib/url';

  type AiUsage = {
    explain: { used: number; limit: number };
    assistant: { enabled: boolean; used: number; limit: number };
    llm: { spent_usd: number; limit_usd: number };
  };

  /** One row: name, "x of y" and a bar that turns red when the limit is used up. */
  function limitRow(name: string, used: number, limit: number, text: string, whenFull: string) {
    const row = document.createElement('div');
    row.className = 'limit';
    const label = document.createElement('p');
    const strong = document.createElement('strong');
    strong.textContent = `${name}: `;
    const full = used >= limit;
    label.append(strong, `${text}${full ? `. ${whenFull}` : '.'}`);
    const meter = document.createElement('div');
    meter.className = 'meter';
    const bar = document.createElement('div');
    bar.style.width = `${limit > 0 ? Math.min(100, (used / limit) * 100) : 100}%`;
    bar.classList.toggle('full', full);
    meter.append(bar);
    row.append(label, meter);
    return row;
  }

  /** Limits of the signed-in person (the teacher's are higher), straight from the database. */
  async function showAiLimits() {
    const box = document.getElementById('ai-limits')!;
    const { data, error } = await supabase.rpc('lms_my_ai_usage');
    const u = data as AiUsage | null;
    if (error || !u) {
      box.textContent = 'Nie udało się sprawdzić limitów.';
      return;
    }
    const usd = (n: number) => `${Number(n).toFixed(2)} USD`;
    box.replaceChildren(
      limitRow('Wytłumacz koledze', u.explain.used, u.explain.limit, `dziś ${u.explain.used} z ${u.explain.limit} wiadomości`, 'Odnowi się o północy'),
      ...(u.assistant.enabled
        ? [limitRow('Asystent przy zadaniach', u.assistant.used, u.assistant.limit, `dziś ${u.assistant.used} z ${u.assistant.limit} pytań`, 'Odnowi się o północy')]
        : []),
      limitRow('Model w zadaniach (ask)', Number(u.llm.spent_usd), Number(u.llm.limit_usd), `w tym miesiącu ${usd(u.llm.spent_usd)} z ${usd(u.llm.limit_usd)}`, 'Odnowi się 1. dnia miesiąca'),
    );
  }

  requireAccess().then((access) => {
    if (!access) return;
    void showAiLimits();
    document.getElementById('account-email')!.textContent = access.email;
    const titles = access.enrollments
      .map((e) => access.courses.find((c) => c.id === e.course_id)?.title)
      .filter(Boolean)
      .join(', ');
    document.getElementById('account-role')!.textContent = access.isTeacher
      ? 'Nauczyciel: widzisz wszystkie kursy i panel z postępami uczniów.'
      : `Zapisany na: ${titles}.`;
  });

  document.getElementById('password-form')!.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target as HTMLFormElement;
    const data = new FormData(form);
    const message = document.getElementById('password-message')!;
    message.hidden = false;
    if (data.get('password') !== data.get('repeat')) {
      message.textContent = 'Hasła się różnią. Wpisz to samo hasło dwa razy.';
      return;
    }
    form.querySelector('button')!.disabled = true;
    const { error } = await supabase.auth.updateUser({ password: data.get('password') as string });
    form.querySelector('button')!.disabled = false;
    if (error) {
      message.textContent =
        error.code === 'same_password'
          ? 'To już jest Twoje hasło.'
          : error.code === 'weak_password'
            ? 'Hasło jest za słabe. Wybierz dłuższe albo mniej oczywiste.'
            : `Nie udało się ustawić hasła: ${error.message}`;
      return;
    }
    form.reset();
    message.textContent = 'Hasło ustawione. Możesz logować się nim w zakładce „Hasło” na stronie logowania.';
  });

  document.getElementById('logout')!.addEventListener('click', async () => {
    await supabase.auth.signOut();
    location.href = url('login/');
  });
</script>

<style>
  h1 {
    font-size: 1.8rem;
    word-break: break-all;
  }
  #logout {
    margin-top: 8px;
  }
  .limits {
    max-width: 420px;
    margin-top: 40px;
    padding: 24px;
  }
  .limits h2,
  .limits p {
    margin: 0 0 8px;
  }
  .limits :global(.limit p) {
    margin: 0;
  }
  .limits :global(.meter) {
    height: 8px;
    margin: 4px 0 12px;
    border-radius: 999px;
    background: var(--surface-2);
    overflow: hidden;
  }
  .limits :global(.meter div) {
    height: 100%;
    background: var(--accent);
  }
  .limits :global(.meter div.full) {
    background: var(--bad);
  }
  .password {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-width: 420px;
    margin-top: 40px;
    padding: 24px;
  }
  .password h2,
  .password p {
    margin: 0;
  }
  .password button {
    align-self: flex-start;
    margin-top: 6px;
  }
</style>
