---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Lekcja" wide>
  <div class="lesson-layout">
    <aside class="toc" id="toc" hidden aria-label="Spis treści">
      <p class="eyebrow">W tej lekcji</p>
      <ol class="toc-list"></ol>
    </aside>

    <div class="lesson-main">
      <a class="back" id="back" href="#">← Kurs</a>
      <header class="lesson-header">
        <p class="eyebrow" id="lesson-number"></p>
        <h1 id="lesson-title"></h1>
        <p class="lesson-meta" id="lesson-meta"></p>
      </header>

      <details class="teacher-notes" id="teacher-notes" hidden>
        <summary>Notatki dla nauczyciela <span class="teacher-only">tylko Ty to widzisz</span></summary>
        <div class="prose teacher-notes-body" id="teacher-notes-body"></div>
      </details>

      <details class="toc-mobile" id="toc-mobile" hidden>
        <summary>Spis treści</summary>
        <ol class="toc-list"></ol>
      </details>

      <article class="prose" id="lesson-body"><p class="loading">Ładuję lekcję…</p></article>

      <section class="tasks card" id="lesson-tasks" hidden>
        <p class="eyebrow">Zadania</p>
        <div id="task-list"></div>
      </section>

      <section class="prose tutor" id="lesson-tutor" hidden>
        <h2>Pomoc między lekcjami: AI jako korepetytor</h2>
        <p>
          Gdy utkniesz, możesz zapytać ChatGPT albo Claude, ale tak, żeby uczył, a nie robił za Ciebie. Skopiuj poniższy tekst, uzupełnij pola w
          nawiasach <code>[]</code> i wklej jako pierwszą wiadomość w nowej rozmowie. Lista tematów jest zawsze aktualna, więc po każdej lekcji bierz
          prompt z najnowszej.
        </p>
        <div id="tutor-prompt"></div>
      </section>

      <section class="export" id="lesson-export" hidden>
        <div>
          <p class="eyebrow">Lekcja jako tekst</p>
          <p class="muted">Cała lekcja z zadaniami w Markdownie. Możesz ją wkleić do ChatGPT albo Claude i zadawać pytania o materiał.</p>
        </div>
        <div class="export-buttons">
          <button id="copy-md" class="primary">Kopiuj lekcję</button>
          <button id="download-md">Pobierz .md</button>
        </div>
      </section>
    </div>
  </div>
</Layout>

<script>
  import { requireAccess, courseBySlug, lessons, tasks, teacherNotes, coursePath, tutorPrompt, type Course, type Lesson, type Task } from '../lib/content';
  import { renderMarkdown, enhanceCodeBlocks } from '../lib/markdown';
  import { splitIntoSections, mountOutline, readingMinutes } from '../lib/lesson-outline';
  import { languageById } from '../lib/languages';
  import { taskStatuses, type TaskStatus } from '../lib/progress';
  import { renderTaskList } from '../lib/task-list';
  import { param } from '../lib/url';

  const $ = (id: string) => document.getElementById(id)!;
  const el = (tag: string, text = '', className = '') => {
    const e = document.createElement(tag);
    e.textContent = text;
    if (className) e.className = className;
    return e;
  };
  const taskCount = (n: number) =>
    n === 1 ? '1 zadanie' : [2, 3, 4].includes(n % 10) && ![12, 13, 14].includes(n % 100) ? `${n} zadania` : `${n} zadań`;
  const fence = (lang: string, code: string) => `\`\`\`${lang}\n${code.replace(/\n$/, '')}\n\`\`\``;

  /** The whole lesson with its tasks as one Markdown document, ready to paste into an AI chat. */
  function lessonAsMarkdown(course: Course, lesson: Lesson, lessonTasks: Task[]): string {
    const lang = languageById(course.language).aliases[0];
    return [
      `# ${course.title}: lekcja ${lesson.number}. ${lesson.title}`,
      `Tematy: ${lesson.topics.join(', ')}`,
      lesson.body_md,
      ...lessonTasks.map((t) =>
        [
          `## Zadanie ${t.number}: ${t.title}`,
          t.body_md,
          t.predict_code && fence(lang, t.predict_code),
          t.starter_code && `Kod startowy:\n\n${fence(lang, t.starter_code)}`,
        ]
          .filter(Boolean)
          .join('\n\n'),
      ),
    ].join('\n\n');
  }

  function showTasks(course: Course, lessonTasks: Task[], statuses: Map<string, TaskStatus>) {
    renderTaskList($('task-list'), course, lessonTasks, statuses);
    $('lesson-tasks').hidden = false;
  }

  function setUpExport(markdown: string, fileName: string) {
    $('lesson-export').hidden = false;
    $('copy-md').addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(markdown);
        $('copy-md').textContent = 'Skopiowano';
      } catch {
        $('copy-md').textContent = 'Nie udało się, użyj „Pobierz .md”';
      }
      setTimeout(() => ($('copy-md').textContent = 'Kopiuj lekcję'), 2500);
    });
    $('download-md').addEventListener('click', () => {
      const link = document.createElement('a');
      link.href = URL.createObjectURL(new Blob([markdown], { type: 'text/markdown;charset=utf-8' }));
      link.download = fileName;
      link.click();
      setTimeout(() => URL.revokeObjectURL(link.href), 1000);
    });
  }

  requireAccess().then(async (access) => {
    if (!access) return;
    const course = await courseBySlug(param('c'));
    const number = Number(param('n'));
    const courseLessons = course ? await lessons(course.id) : [];
    const lesson = courseLessons.find((l) => l.number === number);
    if (!course || !lesson) {
      $('lesson-body').replaceChildren(el('p', 'Ta lekcja nie istnieje albo nie jest jeszcze odblokowana.', 'muted'));
      return;
    }
    document.title = `${lesson.title} · Kurs programowania`;
    ($('back') as HTMLAnchorElement).href = coursePath(course);
    $('back').textContent = `← ${course.title}`;
    $('lesson-number').textContent = `Lekcja ${String(lesson.number).padStart(2, '0')}`;
    $('lesson-title').textContent = lesson.title;
    if (lesson.draft) $('lesson-title').append(el('span', 'szkic: widzisz tylko Ty', 'draft-badge'));
    if (access.isTeacher) {
      const notes = (await teacherNotes(course.id)).get(lesson.number);
      if (notes) {
        $('teacher-notes-body').innerHTML = renderMarkdown(notes);
        enhanceCodeBlocks($('teacher-notes-body'));
        $('teacher-notes').hidden = false;
      }
    }

    $('lesson-body').innerHTML = renderMarkdown(lesson.body_md);
    enhanceCodeBlocks($('lesson-body'));
    const outline = splitIntoSections($('lesson-body'));

    const lessonTasks = (await tasks(course.id)).filter((t) => t.lesson_number === lesson.number);
    if (lessonTasks.length) showTasks(course, lessonTasks, await taskStatuses(lessonTasks.map((t) => t.id)));
    $('lesson-meta').textContent = `ok. ${readingMinutes($('lesson-body'))} min czytania · ${taskCount(lessonTasks.length)}`;

    if (course.tutor_prompt) {
      $('tutor-prompt').innerHTML = renderMarkdown(fence('', tutorPrompt(course, courseLessons, lesson.number)));
      enhanceCodeBlocks($('tutor-prompt'));
      $('lesson-tutor').hidden = false;
    }

    const extra = [
      ...(lessonTasks.length ? [{ id: 'lesson-tasks', title: 'Zadania' }] : []),
      ...(course.tutor_prompt ? [{ id: 'lesson-tutor', title: 'Pomoc z AI' }] : []),
    ];
    if (outline.length > 1) {
      mountOutline([...document.querySelectorAll<HTMLOListElement>('.toc-list')], outline, extra);
      $('toc').hidden = false;
      $('toc-mobile').hidden = false;
      // on phones, close the table of contents after jumping to a section
      $('toc-mobile').addEventListener('click', (e) => {
        if ((e.target as HTMLElement).closest('a')) ($('toc-mobile') as HTMLDetailsElement).open = false;
      });
    }

    setUpExport(lessonAsMarkdown(course, lesson, lessonTasks), `${course.slug}-lekcja-${String(lesson.number).padStart(2, '0')}.md`);
  });
</script>

<style>
  .lesson-layout {
    display: grid;
    grid-template-columns: 220px minmax(0, 720px);
    justify-content: center;
    gap: 64px;
    align-items: start;
  }
  .lesson-layout:has(.toc[hidden]) {
    grid-template-columns: minmax(0, 720px);
  }
  .toc {
    position: sticky;
    top: 88px;
    padding-top: 92px;
    max-height: calc(100vh - 100px);
    overflow-y: auto;
  }
  .toc .eyebrow {
    margin-bottom: 10px;
  }
  .toc-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--line);
  }
  .toc-list :global(li) {
    margin: 0;
  }
  .toc-list :global(a) {
    display: flex;
    gap: 10px;
    padding: 5px 0 5px 14px;
    margin-left: -1px;
    border-left: 2px solid transparent;
    font-size: 13.5px;
    line-height: 1.4;
    color: var(--text-2);
  }
  .toc-list :global(a:hover) {
    color: var(--text);
    text-decoration: none;
  }
  .toc-list :global(a.active) {
    color: var(--text);
    border-left-color: var(--accent);
    font-weight: 500;
  }
  .toc-list :global(.toc-number) {
    font-family: var(--mono);
    font-size: 11.5px;
    color: var(--text-3);
    padding-top: 1px;
    min-width: 18px;
  }
  .toc-mobile {
    display: none;
    margin: 0 0 32px;
    padding: 12px 16px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }
  .toc-mobile summary {
    cursor: pointer;
    font-weight: 500;
  }
  .toc-mobile .toc-list {
    margin-top: 10px;
  }

  .lesson-header {
    padding-bottom: 28px;
    margin-bottom: 8px;
    border-bottom: 1px solid var(--line);
  }
  .lesson-meta {
    color: var(--text-3);
    font-size: 14px;
    margin: 0;
  }

  /* numbered sections built by splitIntoSections() */
  .prose :global(.lesson-section) {
    padding: 40px 0 16px;
    border-bottom: 1px solid var(--line);
    scroll-margin-top: 72px;
  }
  .prose :global(.lesson-section:last-child) {
    border-bottom: 0;
  }
  .prose :global(.lesson-section > h2) {
    display: flex;
    align-items: baseline;
    gap: 14px;
    margin: 0 0 18px;
    font-size: 1.55rem;
  }
  .prose :global(.section-number) {
    font-family: var(--mono);
    font-size: 13px;
    font-weight: 500;
    letter-spacing: 0;
    color: var(--accent);
    flex-shrink: 0;
  }
  .prose :global(h3) {
    margin-top: 32px;
  }
  .prose :global(p),
  .prose :global(li) {
    max-width: 68ch;
  }

  .tutor {
    margin-top: 56px;
    scroll-margin-top: 72px;
  }
  .tutor h2 {
    margin-top: 0;
    font-size: 1.55rem;
  }
  .tutor :global(pre) {
    white-space: pre-wrap;
    max-height: 320px;
    overflow-y: auto;
    font-size: 13.5px;
  }
  .tasks {
    margin-top: 48px;
    padding: 24px 24px 12px;
    scroll-margin-top: 72px;
  }
  .tasks #task-list {
    margin-top: 12px;
  }
  .export {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px 24px;
    flex-wrap: wrap;
    margin-top: 40px;
    padding: 24px 0;
    border-top: 1px solid var(--line);
  }
  .export .muted {
    margin: 4px 0 0;
    font-size: 14px;
    max-width: 52ch;
  }
  .export-buttons {
    display: flex;
    gap: 8px;
  }

  @media (max-width: 1100px) {
    .lesson-layout,
    .lesson-layout:has(.toc[hidden]) {
      grid-template-columns: minmax(0, 720px);
    }
    .toc {
      display: none;
    }
    .toc-mobile:not([hidden]) {
      display: block;
    }
  }
</style>
