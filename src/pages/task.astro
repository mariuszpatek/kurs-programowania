---
import Layout from '../layouts/Layout.astro';
import Workspace from '../components/Workspace.astro';
import Predict from '../components/Predict.astro';
import LocalTask from '../components/LocalTask.astro';
import Assistant from '../components/Assistant.astro';
import Explain from '../components/Explain.astro';
---

<Layout title="Zadanie" wide>
  <nav class="task-nav">
    <a class="back" id="back" href="#">← Zadania</a>
    <a class="notes-link" id="notes-link" href="#" hidden>Notatki z lekcji</a>
  </nav>
  <div class="task-layout">
    <div class="description">
      <button class="ghost fold-text" id="fold-text" type="button" aria-expanded="true">« Zwiń treść</button>
      <p class="eyebrow" id="task-number"></p>
      <h1 id="task-title"></h1>
      <div class="prose" id="task-body"><p class="loading" role="status" aria-label="Ładuję zadanie…"><span class="typed" aria-hidden="true"><span class="fn">wczytaj</span>(<span class="str">"zadanie"</span>)</span></p></div>
      <Explain />
      <section class="hints" id="task-hints" hidden>
        <p class="eyebrow">Podpowiedzi</p>
        <ol class="hint-list"></ol>
        <p class="hint-info muted" hidden></p>
        <button class="hint-button" type="button" hidden></button>
      </section>
      <details class="teacher-notes task-notes" id="task-notes" hidden>
        <summary>Rozwiązanie i wyjaśnienie <span class="teacher-only">tylko Ty to widzisz</span></summary>
        <div class="prose teacher-notes-body" id="task-notes-body"></div>
      </details>
      <p class="next" id="task-next" hidden>
        <span class="eyebrow">Następne</span>
        <a href="#"></a>
      </p>
    </div>
    <div class="work">
      <Workspace />
      <Predict />
      <LocalTask />
      <Assistant />
    </div>
  </div>
</Layout>

<script>
  import { recordVisit } from '../lib/visits';
  import { requireAccess, courseBySlug, lessons, tasks, taskNote, lessonPath, lessonTasksPath, taskPath } from '../lib/content';
  import { renderMarkdown, enhanceContent } from '../lib/markdown';
  import { mountWorkspace } from '../lib/workspace';
  import { mountPredict } from '../lib/predict';
  import { mountLocalTask } from '../lib/local-task';
  import { mountChoice } from '../lib/choice';
  import { mountExplain } from '../lib/explain';
  import { mountAssistant } from '../lib/assistant';
  import { mountHints } from '../lib/hints';
  import { languageById } from '../lib/languages';
import { param } from '../lib/url';

  const $ = (id: string) => document.getElementById(id)!;

  requireAccess().then(async (access) => {
    if (!access) return;
    const course = await courseBySlug(param('c'));
    const all = course ? await tasks(course.id) : [];
    const index = all.findIndex((t) => t.slug === param('t'));
    const task = all[index];
    if (!course || !task) {
      $('task-body').textContent = 'To zadanie nie istnieje albo nie jest jeszcze odblokowane.';
      return;
    }
    const courseLessons = await lessons(course.id);
    const lesson = courseLessons.find((l) => l.number === task.lesson_number);

    recordVisit(access, { courseId: course.id, lessonNumber: task.lesson_number, taskId: task.id });
    document.title = `${task.title} · Kurs programowania`;
    ($('back') as HTMLAnchorElement).href = lessonTasksPath(course, task.lesson_number);
    $('back').textContent = `← Zadania z lekcji ${task.lesson_number}`;
    if (lesson) {
      ($('notes-link') as HTMLAnchorElement).href = lessonPath(course, lesson.number);
      $('notes-link').textContent = `Notatki: ${lesson.title}`;
      $('notes-link').hidden = false;
    }
    $('task-number').textContent = `Lekcja ${String(task.lesson_number).padStart(2, '0')} · ${task.in_class ? 'Na lekcji' : 'Zadanie domowe'} ${task.number}`;
    $('task-title').textContent = task.title;
    if (task.draft) $('task-title').append(Object.assign(document.createElement('span'), { className: 'draft-badge', textContent: 'szkic' }));
    if (task.kind === 'explain') $('task-title').append(Object.assign(document.createElement('span'), { className: 'explain-badge', textContent: 'rozmowa z AI · beta' }));
    $('task-body').innerHTML = renderMarkdown(task.body_md);
    enhanceContent($('task-body'));
    mountHints($('task-hints'), task, access.isTeacher);
    if (access.isTeacher) {
      const note = await taskNote(course.id, task.slug);
      if (note) {
        $('task-notes-body').innerHTML = renderMarkdown(note);
        enhanceContent($('task-notes-body'));
        $('task-notes').hidden = false;
      }
    }
    const language = languageById(course.language);

    const next = all[index + 1];
    if (next && next.lesson_number === task.lesson_number) {
      const link = $('task-next').querySelector('a')!;
      link.href = taskPath(course, next);
      link.textContent = `${next.title} →`;
      $('task-next').hidden = false;
    }

    if (task.kind === 'predict') {
      mountPredict(document.querySelector('.predict')!, task, language);
    } else if (task.kind === 'local') {
      mountLocalTask(document.querySelector('.local-task')!, task);
    } else if (task.kind === 'choice') {
      // the questions are in the text, so there is nothing to put in the work column
      document.querySelector('.task-layout')!.classList.add('choice');
      mountChoice($('task-body'), task);
    } else if (task.kind === 'explain') {
      // a conversation instead of code: one column, and the friend replaces the assistant
      document.querySelector('.task-layout')!.classList.add('choice');
      void mountExplain(document.querySelector<HTMLElement>('.explain')!, task);
      return;
    } else {
      const layout = document.querySelector<HTMLElement>('.task-layout')!;
      const kodek = document.querySelector<HTMLDetailsElement>('.assistant details')!;
      let kodekWasOpen = true;
      mountWorkspace(document.querySelector('.workspace')!, {
        language,
        draftKey: task.id,
        starterCode: task.starter_code,
        task: { id: task.id, tests: task.tests },
        // full screen: the text, the editor and the console; Kodek folded under the text
        fullscreen: {
          scope: layout,
          onChange: (on) => {
            if (on) kodekWasOpen = kodek.open;
            kodek.open = on ? false : kodekWasOpen;
            if (!on) foldText(false);
          },
        },
      });
      const foldText = (folded: boolean) => {
        layout.classList.toggle('text-folded', folded);
        $('fold-text').textContent = folded ? '»' : '« Zwiń treść';
        $('fold-text').setAttribute('aria-expanded', String(!folded));
        $('fold-text').setAttribute('aria-label', folded ? 'Pokaż treść zadania' : 'Zwiń treść zadania');
      };
      $('fold-text').addEventListener('click', () => foldText(!layout.classList.contains('text-folded')));
    }
    void mountAssistant(task.id);
  });
</script>

<style>
  .task-nav {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .task-nav .back {
    margin-bottom: 0;
  }
  .notes-link {
    font-size: 14px;
  }
  .task-layout {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: 48px;
    align-items: start;
  }
  .task-layout.choice {
    grid-template-columns: minmax(0, 760px);
  }
  /* closed questions (and Robcio) are in the text column; the work column only holds the tutor, under them */
  .task-layout.choice .work:not(:has(.assistant:not([hidden]))) {
    display: none;
  }
  .work {
    position: sticky;
    top: 80px;
  }
  /* with the tutor the column is taller than the screen, and a sticky one would hide the chat */
  .work:has(.assistant:not([hidden])) {
    position: static;
  }
  .description {
    max-width: 62ch;
  }
  .hints {
    margin: 28px 0;
    padding: 16px 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: var(--surface);
  }
  .hints .eyebrow {
    margin: 0 0 8px;
  }
  .hint-list {
    margin: 0 0 8px;
    padding-left: 20px;
  }
  .hint-list:empty {
    display: none;
  }
  .hint-list :global(p) {
    margin: 0 0 8px;
  }
  .hint-info {
    margin: 0;
    font-size: 14px;
  }
  .description h1 {
    margin-top: 6px;
    margin-bottom: 20px;
  }
  .next {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 32px 0 0;
    padding-top: 20px;
    border-top: 1px solid var(--line);
  }

  /* "Pełny ekran" (src/lib/fullscreen.ts, the button on the editor's bar): the text with the hints and Kodek
     in a narrow column, the editor and the console (Workspace.astro) in the rest. The elements stay where
     they are; .work only stops being a box, so its children become cells of this grid. */
  .fold-text {
    display: none;
  }
  .task-layout.fullscreen {
    position: fixed;
    inset: 0;
    z-index: 100;
    padding: 12px;
    gap: 12px;
    background: var(--bg);
    grid-template-columns: minmax(240px, 340px) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) auto;
    grid-template-areas: 'text code' 'kodek code';
    align-items: stretch;
  }
  .task-layout.fullscreen .description {
    grid-area: text;
    max-width: none;
    min-height: 0;
    overflow: auto;
    padding: 4px 6px 12px 4px;
  }
  .task-layout.fullscreen .description h1 {
    font-size: 1.45rem;
  }
  .task-layout.fullscreen .fold-text {
    display: inline-flex;
    height: 28px;
    font-size: 13px;
    margin-bottom: 8px;
  }
  .task-layout.fullscreen .work {
    display: contents;
  }
  .task-layout.fullscreen :global(.workspace) {
    grid-area: code;
    min-height: 0;
  }
  .task-layout.fullscreen :global(.assistant) {
    grid-area: kodek;
    margin: 0;
    padding-top: 12px;
    max-height: 60vh;
    overflow: auto;
  }
  .task-layout.fullscreen.text-folded {
    grid-template-columns: 44px minmax(0, 1fr);
  }
  .task-layout.fullscreen.text-folded .description > :not(.fold-text),
  .task-layout.fullscreen.text-folded :global(.assistant) {
    display: none;
  }
  .task-layout.fullscreen.text-folded .fold-text {
    padding: 0 10px;
  }
  @media (max-width: 900px) {
    .task-layout.fullscreen {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
      grid-template-areas: 'text' 'code';
    }
    .task-layout.fullscreen .description {
      max-height: 28vh;
    }
    .task-layout.fullscreen :global(.assistant),
    .task-layout.fullscreen .fold-text {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .task-nav {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 8px 24px;
    flex-wrap: wrap;
    margin-bottom: 24px;
  }
  .task-nav .back {
    margin-bottom: 0;
  }
  .notes-link {
    font-size: 14px;
  }
  .task-layout {
      grid-template-columns: minmax(0, 1fr);
    }
    .work {
      position: static;
    }
  }
</style>
